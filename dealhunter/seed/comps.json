  "penalties": [
    {
      "id": "icloud-lock",
      "pattern": "icloud (lock|activation)|activation lock|find my (iphone|ipad) (on|enabled)",
      "multiplier": 0.15,
      "note": "iCloud activation lock \u2014 resale is parts value only"
    },
    {
      "id": "mdm-enrolled",
      "pattern": "(enterprise|domain|district) enroll|mdm (lock|enrolled)|still enrolled",
      "multiplier": 0.35,
      "note": "Device still enrolled in someone else's management \u2014 buyer cannot release it"
    },
    {
      "id": "bios-locked",
      "pattern": "bios password|supervisor password|computrace|bios lock",
      "multiplier": 0.4,
      "note": "BIOS/supervisor password set \u2014 needs board work or is scrap"
    },
    {
      "id": "meraki-unlicensed",
      "pattern": "meraki",
      "requires": "unlicensed|licen[sc]e[sd]? (expired|not transferable|non-transferable)",
      "multiplier": 0.3,
      "note": "Meraki hardware without a transferable licence is close to worthless",
      "supersedes": [
        "licence-expired"
      ]
    },
    {
      "id": "licence-expired",
      "pattern": "licen[sc]e[sd]? (expired|not transferable|non-transferable)",
      "multiplier": 0.75,
      "note": "Software licence does not transfer with the hardware"
    },
    {
      "id": "untested",
      "pattern": "untested|not tested|unable to test|condition unknown",
      "multiplier": 0.8,
      "note": "Untested \u2014 assume a share of the lot is dead"
    },
    {
      "id": "cracked",
      "pattern": "cracked|broken screen|shattered|water damage",
      "multiplier": 0.5,
      "note": "Physical damage called out in the listing"
    },
    {
      "id": "no-drives",
      "pattern": "no (hard )?drives|drives (removed|destroyed|wiped and removed)|hdd removed",
      "multiplier": 0.95,
      "note": "Drives removed \u2014 normal for surplus IT, small deduction for the caddies"
    },
    {
      "id": "no-power-supply",
      "pattern": "no (chargers?|power (supply|adapters?|cords?))|chargers? not included",
      "multiplier": 0.93,
      "note": "No power adapters \u2014 you will buy them"
    },
    {
      "id": "missing-parts",
      "pattern": "missing (parts|components|keys)|incomplete",
      "multiplier": 0.7,
      "note": "Listing admits missing components"
    }
  ],
  "bulk": {
    "note": "Selling 200 identical units takes months and pushes the price down. Multiplier = 1 - slope * log10(qty), floored.",
    "slope": 0.08,
    "floor": 0.6
  },
