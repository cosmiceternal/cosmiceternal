# dealhunter — copy to .env (or export these) and adjust. Everything is
# optional: with no configuration at all the service runs against the bundled
# sample lots so you can see the whole pipeline work before pointing it at a
# live site.
#
# Anything here can also live in dealhunter.config.json, which is easier for the
# nested cost model. The environment always wins over the file.

# --- Runtime ---
PORT=3100
HOST=0.0.0.0
DEALHUNTER_DATA_DIR=./var
LOG_LEVEL=info          # debug | info | warn | error | silent
LOG_FORMAT=text         # text | json

# Set this and every /api route requires "Authorization: Bearer <token>".
# The dashboard asks for it once and remembers it. Set it before exposing the
# service to anything but localhost.
API_TOKEN=

# --- Sources ---
# Comma-separated source ids. Run `dealhunter sources` to see what is available.
# "sample" is the bundled offline fixture set; the live recipes ship UNVERIFIED
# (see the README) because neither GovDeals nor the ITAD houses publish a
# documented API.
SOURCES=sample

SCRAPE_INTERVAL_MS=900000     # 15 minutes
SCRAPE_ON_START=1
MAX_PAGES_PER_SOURCE=3

# --- Scraping manners ---
# One request every two seconds per host by default. Be conservative: these are
# small operations and getting blocked ends your alerts.
REQUESTS_PER_SECOND=0.5
REQUEST_TIMEOUT_MS=20000
RESPECT_ROBOTS=1
USER_AGENT=dealhunter/1.0 (personal deal alerts; contact via repository issues)

# Override a source's endpoint without editing its recipe file.
# GOVDEALS_SEARCH_URL=
# ITAD_RECIPES=/path/to/your/recipes

# --- What to hunt (empty = everything) ---
# CATEGORIES=laptops,servers,networking,testequipment
# KEYWORDS=latitude,thinkpad,poweredge
EXCLUDE_KEYWORDS=parts only,scrap metal

# --- Economics: rates are fractions, not percents ---
BUYER_PREMIUM_PCT=0.10        # GovDeals premium; varies by seller, check the lot
SALES_TAX_PCT=0               # 0 if you hold a resale certificate
MARKETPLACE_FEE_PCT=0.13      # marketplace final-value fee
INBOUND_FREIGHT_FLAT=150      # freight or your own truck + time, per lot
REFURB_COST_PER_UNIT=15       # wipe, test, clean, parts
OUTBOUND_SHIP_PER_UNIT=18     # what you eat shipping each unit out
SELL_THROUGH_PCT=0.9          # the share of units you actually expect to sell

# --- What counts as a deal ---
MIN_MARGIN_PCT=0.35
MIN_PROFIT=150
MIN_ROI=0.4
MIN_CONFIDENCE=0.35           # keep unverified comps out of your alerts

# --- Alerting ---
ALERT_COOLDOWN_MINUTES=360
# WEBHOOK_URL=https://example.com/hooks/dealhunter
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
