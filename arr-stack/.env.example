# Copy to .env and adjust:  cp .env.example .env
# ---------------------------------------------------------------------------

# User/group that should OWN the config + media files on the host.
# Find yours with:  id -u   (PUID)   and   id -g   (PGID)
# Getting this wrong is the usual cause of "permission denied" on imports.
PUID=1000
PGID=1000

# Your timezone as a TZ database name, e.g. America/New_York, Europe/London.
TZ=Etc/UTC

# Where each app keeps its own config/database. Small — back this up.
CONFIG_ROOT=./config

# Single data root holding BOTH downloads and the media library. It must be
# one mount so Sonarr/Radarr can hardlink from torrents/ into media/ instead
# of copying (instant, no double disk usage). Expected layout:
#   ${DATA_ROOT}/torrents        <- qBittorrent saves here
#   ${DATA_ROOT}/media/tv        <- Sonarr root folder
#   ${DATA_ROOT}/media/movies    <- Radarr root folder
DATA_ROOT=./data

# Host ports (change the left side only if something else already uses them).
PROWLARR_PORT=9696
SONARR_PORT=8989
RADARR_PORT=7878
BAZARR_PORT=6767
QBIT_WEBUI_PORT=8080
FLARESOLVERR_PORT=8191
FLARESOLVERR_LOG_LEVEL=info
